# Pockt — Environment Variables (backend)
# Copy to .env / set in your shell / pass via docker-compose.

# SQLite database file path.
# Defaults: pockt.dev.db (development) or pockt.prod.db (NODE_ENV=production).
# Tests use pockt.test.db automatically via vitest.config.ts.
DATABASE_URL=pockt.dev.db

# Backend HTTP server
PORT=3001
HOST=0.0.0.0

# Session cookie signing secret.
# IMPORTANT: set a long random value in production (docker-compose.yml default is a placeholder).
COOKIE_SECRET=change-me-to-a-long-random-string

# Set to production when deploying (selects pockt.prod.db).
# NODE_ENV=production
