# Pockt — Environment Variables
# Copy to .env / set in your shell / pass via docker-compose.
# docker compose automatically reads .env from the project directory.

# --- Backend (apps/backend) ---

# SQLite database file path.
# Defaults: pockt.dev.db (development) or pockt.prod.db (NODE_ENV=production).
# Tests use pockt.test.db automatically via vitest.config.ts.
DATABASE_URL=pockt.dev.db

# Backend HTTP server
PORT=3001
HOST=0.0.0.0

# Session cookie signing secret.
# IMPORTANT: set a long random value in production (docker-compose falls back to a placeholder).
COOKIE_SECRET=change-me-to-a-long-random-string

# Set to production when deploying (selects pockt.prod.db).
# NODE_ENV=production

# --- Web (apps/web, only needed when web and backend run in separate containers) ---

# Internal URL used by the server-side /api proxy to reach the backend.
# docker-compose sets this automatically to http://pockt-backend:3001.
API_INTERNAL_URL=http://localhost:3001
